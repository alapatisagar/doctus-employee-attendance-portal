# DOCTUS EMPLOYEE ATTENDANCE PORTAL - Production Environment Variables
# Copy this file to .env.production when deploying to Netlify or hosting environments.

# Firebase Configuration (From Firebase Console -> Project Settings -> General)
VITE_FIREBASE_API_KEY=AIzaSy...YourProductionApiKey
VITE_FIREBASE_AUTH_DOMAIN=doctus-attendance-prod.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=doctus-attendance-prod
VITE_FIREBASE_STORAGE_BUCKET=doctus-attendance-prod.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=102938475612
VITE_FIREBASE_APP_ID=1:102938475612:web:a1b2c3d4e5f6

# Production Security & Demo Lockdown Flag (MUST be false for real employee onboarding)
VITE_ENABLE_DEMO_MODE=false
